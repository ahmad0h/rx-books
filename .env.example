# Copy this file to .env and set real passwords before the first start.
# Use letters and numbers only in passwords: they are placed inside a database URL.
# .env is ignored by git and must never be committed.

MYSQL_DATABASE=rxbooks
MYSQL_USER=rxbooks
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Host ports (change if something else already uses them)
MYSQL_PORT=3307
BACKEND_PORT=3000
FRONTEND_PORT=8080

APP_VERSION=0.1.0

# Sign-in. JWT_SECRET: a long random string, e.g. the output of `openssl rand -hex 32`.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
SESSION_HOURS=8
# Must be true in production (HTTPS only).
COOKIE_SECURE=false

# Demo users, created at start-up for local development only.
# Sign in with these emails and passwords. Never enable in production.
DEMO_USERS_ENABLED=true
DEMO_ADMIN_EMAIL=admin@rxbooks.test
DEMO_ADMIN_PASSWORD=change-me-admin-password
DEMO_CLIENT_EMAIL=client@rxbooks.test
DEMO_CLIENT_PASSWORD=change-me-client-password
