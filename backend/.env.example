# Only needed when running the backend outside Docker (Nest loads backend/.env automatically).
# Copy to backend/.env. The database is the one started by docker compose (port 3307).
DATABASE_URL=mysql://rxbooks:change-me@localhost:3307/rxbooks
DATABASE_TLS=false
PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
SESSION_HOURS=8
COOKIE_SECURE=false
DEMO_USERS_ENABLED=true
DEMO_ADMIN_EMAIL=admin@rxbooks.test
DEMO_ADMIN_PASSWORD=change-me-admin-password
DEMO_CLIENT_EMAIL=client@rxbooks.test
DEMO_CLIENT_PASSWORD=change-me-client-password
